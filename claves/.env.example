# AulaSense — claves/.env (F25, D-F25-9)
# Copiar a claves/.env. Esta carpeta está GITIGNORED (claves/*): NUNCA commitear valores reales.
# Regla dura (AGENTS 15): las contraseñas NUNCA las asigna el modelo ni se imprimen.
# La password admin la GENERA el código (secrets.token_hex(16)) en F25-e y se escribe aquí;
# entrega al dueño por canal local (este archivo en disco). tools/reset_admin.py la regenera.

# --- Login del dashboard (admin único inicial) ---
AULASENSE_ADMIN_USER=admin
# Generada por código en F25-e. NUNCA escrita por el modelo, nunca impresa, nunca commiteada.
AULASENSE_ADMIN_PASSWORD=

# --- Key de IA para el worker de visión (opcional) ---
# Pay-as-you-go (sk-*): habilita el modo A (daemon autónomo) y modelos qwen3-vl-flash/qwen-vl-max.
# Vacío: el worker resuelve la key del Token Plan (sk-sp-) desde auth.json SOLO para el modo B
# (agente-mediado interactivo; los ToS del TP prohíben backends autónomos con sk-sp-).
# El sistema completo funciona con esta clave vacía (regla 13).
DASHSCOPE_API_KEY=