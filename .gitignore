# Temporales (regla dura: siempre en .tmp/, nunca %TEMP%/AppData)
.tmp/
*.log

# Secretos (NUNCA commitear claves reales)
.env
# F25: credenciales de auth/IA (generadas SOLO por código; entrega al dueño por canal local)
claves/*
!claves/.env.example
firmware/**/sdkconfig.defaults.local
firmware/**/credentials.h

# Vendor ESPectre (clon reproducible por tag 3.2.0 SIN prefijo v, GPLv3 — no se trackea el clon)
firmware/espectre/

# Builds de firmware
firmware/**/build/
firmware/**/build-flash-*/
firmware/**/sdkconfig
firmware/**/sdkconfig.old
firmware/**/dependencies.lock
firmware/**/.cache/
firmware/**/managed_components/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Datos vivos del server (el dataset consolidado real SÍ se trackea en analysis/dataset/)
server/datos/*.db
server/datos/*.db-wal
server/datos/*.db-shm
server/datos/export_*.csv
# F24: imágenes de evidencia = datos personales, NUNCA commitear (privacidad acotada local-only)
server/datos/imagenes/
# F25: intermedios de video (escenas/audio regenerables, pesan); el mp4 final vive en docs/
assets/video/

# Sistema
.DS_Store
Thumbs.db