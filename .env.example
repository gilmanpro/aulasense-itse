# AulaSense — variables de entorno
# Copiar a .env y rellenar. .env está GITIGNORED: NUNCA commitear claves reales.
# Regla dura: las contraseñas NUNCA las asigna el modelo ni se imprimen; aquí solo NOMBRES
# con valores vacíos o placeholder. Toda credencial real vive solo en .env / NVS de la placa.

# --- Broker MQTT (E6: TCP 14769 y WSS 443 OK; 1883/1884/8083 filtrados) ---
MQTT_HOST=broker.gilman.pro
MQTT_PORT=14769
# Esquema: mqtt (TCP plano) o mqtts (TLS con CA pública). Native NO soporta WebSocket ni CA privada.
# Se verifica empíricamente en el gate F1d (ambos esquemas soportados nativamente).
MQTT_SCHEME=mqtt
MQTT_USER=electiva
MQTT_PASS=
# Prefijo de topics propio para aislar del broker compartido (device_id de 16 hex lo añade el nodo)
MQTT_TOPIC_PREFIX=aulasense/v1/devices

# --- WiFi del nodo (2.4 GHz obligatorio; el S3 no ve 5 GHz) ---
WIFI_SSID=
WIFI_PASS=
# El CLI de ESPectre (provision) lee la clave de esta env var, NUNCA por argv ni impresa:
ESPECTRE_WIFI_PASSWORD=

# --- Identidad del nodo ---
DEVICE_LABEL=AulaSense-01

# --- Open-Meteo (C6, gratis sin API key, uso no comercial) ---
# Coordenadas del aula: rellenar cuando se conozcan (P1). Vacío → el fetcher degrada con elegancia
# (C6 queda cubierta igualmente por la die temp del S3).
OPENMETEO_LAT=
OPENMETEO_LON=

# --- Dashboard (Origin guard extra opt-in: host[:puerto] exactos, sin wildcards, separados por coma) ---
# Los defaults 127.0.0.1/localhost NO se tocan. Vacío = solo loopback.
AULASENSE_ORIGINS_EXTRA=

# --- F24: receptor de imagen HTTP (ingesta :8001). El nodo sube evidencia QVGA al onset de motion ---
# IP LAN del PC donde corre la ingesta. VACÍO = receptor DESACTIVADO (seguro). NUNCA 0.0.0.0 por default.
AULASENSE_UPLOAD_HOST=
AULASENSE_UPLOAD_PORT=8001
# Bearer token del receptor. NUNCA lo asigna el modelo: lo genera tools/gen_firmware_config.py con
# secrets.token_hex(16) → aquí + sdkconfig.defaults.local (gitignored). Nunca impreso ni commiteado.
AULASENSE_UPLOAD_TOKEN=
# Retención de imágenes (días). tools/purga_imagenes.py borra el archivo y marca imagen_purgada=1
# CONSERVANDO la fila+ia (el dataset no se rompe). Default 30.
AULASENSE_IMG_RETENCION_DIAS=30

# --- F24: MQTT ingesta (el nodo publica como electiva vía MQTT_USER; la ingesta suscribe como srv-electiva) ---
MQTT_INGESTA_USER=srv-electiva

# --- Opcional Qwen (el sistema completo funciona con esta clave vacía) ---
DASHSCOPE_API_KEY=