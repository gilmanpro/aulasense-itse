# AulaSense — ingesta MQTT (runtime primario WSL Debian 13, SPEC §15.1 / D-F25-3).
# Instalación (root dentro de WSL): ver server/deploy/README_wsl.md.
# Escritor único de la DB: si este servicio corre, el stack Windows debe estar PARADO.
[Unit]
Description=AulaSense ingesta MQTT (escritor unico SQLite + receptor HTTP :8001 segun .env)
Documentation=file:///home/aulasense/aulasense/server/deploy/README_wsl.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=aulasense
Group=aulasense
WorkingDirectory=/home/aulasense/aulasense
# Rutas ABSOLUTAS: systemd EnvironmentFile no expande ~ (leccion F25-b1).
# OJO (hallazgo README §P8): en systemd el EnvironmentFile PISA los Environment= de
# esta unit. Los valores de abajo son el INTENTADO; el .env manda si define la variable.
EnvironmentFile=/home/aulasense/aulasense/.env
Environment=PYTHONUNBUFFERED=1
Environment=AULASENSE_DB=/home/aulasense/aulasense-datos/aulasense.db
Environment=AULASENSE_DATOS_DIR=/home/aulasense/aulasense-datos
# Secreto por EnvironmentFile NUNCA por argv (AGENTS.md regla 7): MQTT_PASS y
# AULASENSE_UPLOAD_TOKEN viajan solo en el entorno (campo repr=False en
# ingesta_mqtt.py; jamas se imprimen). No anadir tokens a ExecStart.
# Receptor :8001 = OPT-IN por AULASENSE_UPLOAD_HOST en el .env: vacio=DESACTIVADO
# (estado WSL actual). Si se activa, IP EXACTA (p. ej. 172.26.159.208, la NAT de la
# VM en F25-b1); los comodines 0.0.0.0/::/* los RECHAZA el codigo
# (server/ingesta/receptor_imagen.py:248). No fijar aqui con Environment=: el .env
# mandaria igualmente y el valor de la unit daria una falsa sensacion de control.
ExecStart=/home/aulasense/venvs/aulasense/bin/python server/ingesta/ingesta_mqtt.py
Restart=on-failure
RestartSec=5
# El primer arranque importa pandas/scikit-learn: margen holgado antes de matar.
TimeoutStopSec=20
KillSignal=SIGTERM
# --- Hardening (F25-auditoria 2026-11-15). Sin ProtectHome: rompería los binds a
# /home/aulasense/aulasense (código+venv) y /home/aulasense/aulasense-datos (DB). ---
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
# JPEGs de evidencia y DB/exports creados solo legibles por el usuario dedicado.
UMask=0077
# Techos generosos (import pandas+sk-learn ~cientos de MB) pero acotados: un run-away
# no debe tumbar la VM que comparten las otras distros (D-F25-3).
MemoryMax=1G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
